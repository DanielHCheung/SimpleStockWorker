---
// src/pages/index.astro
// Data is fetched at runtime from /data/report_data.json (generated by main.py)
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SimpleStockWorker — Strategy Monitor</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --bg:       #080b10;
      --surface:  #0e1318;
      --border:   #1e2730;
      --border2:  #2a3540;
      --text:     #c8d6e5;
      --muted:    #556070;
      --accent:   #f5a623;
      --green:    #00d68f;
      --red:      #ff4d6d;
      --blue:     #4da6ff;
      --mono:     'IBM Plex Mono', monospace;
      --sans:     'IBM Plex Sans', sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--sans);
      font-size: 13px;
      min-height: 100vh;
    }

    /* ── TOP BAR ── */
    header {
      border-bottom: 1px solid var(--border);
      padding: 0 24px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--surface);
    }

    .brand {
      font-family: var(--mono);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: var(--accent);
      text-transform: uppercase;
    }

    .header-right {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--muted);
    }

    #live-time { color: var(--text); }

    /* ── LAYOUT ── */
    main {
      display: flex;
      min-height: calc(100vh - 48px);
    }

    .sidebar {
      width: 260px;
      flex: 0 0 260px;
      background: var(--surface);
      border-right: 1px solid var(--border);
      padding: 20px 14px;
      transition: width 0.2s ease, flex-basis 0.2s ease;
    }

    .sidebar.collapsed {
      width: 58px;
      flex-basis: 58px;
    }

    .sidebar-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .sidebar-title {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .sidebar.collapsed .sidebar-title,
    .sidebar.collapsed .strategy-tab .tab-text,
    .sidebar.collapsed .strategy-tab .tab-nav {
      display: none;
    }

    .collapse-btn {
      background: transparent;
      border: 1px solid var(--border2);
      color: var(--muted);
      cursor: pointer;
      padding: 5px 8px;
      font-family: var(--mono);
    }

    .strategy-list {
      display: grid;
      gap: 1px;
    }

    .strategy-tab {
      width: 100%;
      text-align: left;
      background: transparent;
      border: 1px solid transparent;
      color: var(--muted);
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.04em;
      padding: 12px 10px;
      cursor: pointer;
      white-space: normal;
      position: relative;
      transition: color 0.15s ease, background 0.15s ease;
    }

    .strategy-tab:hover {
      color: var(--text);
      background: #101720;
    }

    .strategy-tab.active {
      color: var(--accent);
      background: #12161c;
      border-color: var(--border2);
    }

    .strategy-tab.active::after {
      content: '';
      position: absolute;
      left: 0; right: 0; bottom: 0;
      height: 2px;
      background: var(--accent);
    }

    .strategy-tab .tab-nav {
      display: block;
      font-size: 9px;
      color: var(--muted);
      margin-top: 2px;
      letter-spacing: 0.02em;
    }

    .content {
      flex: 1;
      min-width: 0;
      padding: 20px 24px;
      width: 100%;
    }

    .date-controls {
      display: flex;
      align-items: end;
      gap: 10px;
      flex-wrap: wrap;
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 10px 14px;
      margin-bottom: 20px;
    }

    .date-field {
      display: grid;
      gap: 4px;
      font-family: var(--mono);
      font-size: 9px;
      color: var(--muted);
      text-transform: uppercase;
    }

    .date-field input {
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border2);
      padding: 5px 7px;
      font-family: var(--mono);
      font-size: 11px;
    }

    .date-reset {
      color: var(--accent);
      background: transparent;
      border: 1px solid var(--border2);
      padding: 6px 10px;
      cursor: pointer;
      font-family: var(--mono);
      font-size: 10px;
    }

    .state-legend {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .state-legend .legend-item { white-space: nowrap; }

    .strategy-tab.active .tab-nav {
      color: var(--text);
    }

    /* ── STAT CARDS ── */
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      margin-bottom: 20px;
    }

    .card {
      background: var(--surface);
      padding: 16px 18px;
      position: relative;
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: var(--border2);
    }

    .card.accent-green::before { background: var(--green); }
    .card.accent-red::before   { background: var(--red); }
    .card.accent-blue::before  { background: var(--blue); }
    .card.accent-amber::before { background: var(--accent); }

    .card-label {
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 10px;
    }

    .card-value {
      font-family: var(--mono);
      font-size: 22px;
      font-weight: 600;
      line-height: 1;
      color: var(--text);
    }

    .card-sub {
      font-family: var(--mono);
      font-size: 10px;
      color: var(--muted);
      margin-top: 6px;
    }

    .pos { color: var(--green); }
    .neg { color: var(--red); }

    /* ── CHART PANEL ── */
    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      margin-bottom: 20px;
    }

    .panel-header {
      border-bottom: 1px solid var(--border);
      padding: 10px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .panel-title {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .legend {
      display: flex;
      gap: 16px;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: var(--mono);
      font-size: 10px;
      color: var(--muted);
    }

    .legend-dot {
      width: 20px;
      height: 2px;
      border-radius: 1px;
    }

    .panel-body {
      padding: 16px 18px;
    }

    .chart-wrap {
      position: relative;
      width: 100%;
      max-width: 1100px;
      height: clamp(210px, 30vw, 360px);
      margin: 0 auto;
    }

    .drawdown-wrap {
      position: relative;
      width: 100%;
      max-width: 1100px;
      height: clamp(140px, 16vw, 230px);
      margin: 0 auto;
    }

    /* ── REGIME BAR ── */
    .regime-bar-wrap {
      display: flex;
      height: 20px;
      gap: 1px;
      margin-bottom: 4px;
    }

    .regime-segment {
      flex: 1;
      border-radius: 1px;
    }

    .regime-labels {
      display: flex;
      justify-content: space-between;
      font-family: var(--mono);
      font-size: 9px;
      color: var(--muted);
      margin-bottom: 12px;
    }

    /* ── FOOTER ── */
    footer {
      border-top: 1px solid var(--border);
      padding: 12px 24px;
      display: flex;
      justify-content: space-between;
      font-family: var(--mono);
      font-size: 10px;
      color: var(--muted);
    }

    /* ── LOADING ── */
    #loading {
      position: fixed;
      inset: 0;
      background: var(--bg);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.2em;
      color: var(--muted);
      z-index: 100;
    }

    .blink {
      animation: blink 1s step-end infinite;
    }

    @keyframes blink { 50% { opacity: 0; } }

    canvas {
      display: block;
      width: 100% !important;
      max-width: 100%;
    }

    /* Strategy buttons are created after Astro renders the page, so they
       need global selectors instead of Astro's scoped selectors. */
    :global(.strategy-list) {
      display: grid;
      gap: 6px;
    }

    :global(.strategy-tab) {
      width: 100%;
      min-height: 52px;
      text-align: left;
      background: #111820;
      border: 1px solid var(--border2);
      border-radius: 5px;
      color: var(--muted);
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.04em;
      padding: 10px 12px;
      cursor: pointer;
      white-space: normal;
      position: relative;
      transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    }

    :global(.strategy-tab:hover) {
      color: var(--text);
      background: #17212c;
      border-color: var(--blue);
    }

    :global(.strategy-tab.active) {
      color: var(--accent);
      background: #1a2028;
      border-color: var(--accent);
    }

    :global(.strategy-tab.active::after) {
      content: '';
      position: absolute;
      left: 0;
      top: 8px;
      bottom: 8px;
      width: 3px;
      background: var(--accent);
      border-radius: 2px;
    }

    :global(.strategy-tab .tab-nav) {
      display: block;
      font-size: 9px;
      color: var(--muted);
      margin-top: 4px;
      letter-spacing: 0.02em;
    }

    :global(.strategy-tab.active .tab-nav) { color: var(--text); }
    .sidebar.collapsed :global(.strategy-list) { display: none; }

    @media (max-width: 760px) {
      .sidebar { width: 58px; flex-basis: 58px; }
      .sidebar .strategy-list { display: none; }
      .sidebar-title, .strategy-tab .tab-text, .strategy-tab .tab-nav { display: none; }
      .cards { grid-template-columns: 1fr; }
      .content { padding: 14px; }
      header { padding: 0 14px; }
      .brand { font-size: 10px; }
    }

    @media (max-width: 560px) {
      .cards {
        grid-template-columns: 1fr;
      }

      .card {
        min-width: 0;
        padding: 18px 20px;
      }

      .card-value {
        font-size: clamp(20px, 7vw, 28px);
      }

      .panel-header {
        align-items: flex-start;
        gap: 10px;
        flex-wrap: wrap;
      }
    }
  </style>
</head>
<body>

<div id="loading">LOADING DATA<span class="blink">_</span></div>

<header>
  <span class="brand">SimpleStockWorker // Strategy Monitor</span>
  <span class="header-right">UTC <span id="live-time">--:--:--</span></span>
</header>

<main>
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-head">
      <span class="sidebar-title">Strategies</span>
      <button class="collapse-btn" id="collapse-sidebar" type="button" aria-label="Collapse strategy menu">‹</button>
    </div>
    <div class="strategy-list" id="strategy-bar"></div>
  </aside>

  <section class="content">
  <div class="date-controls">
    <label class="date-field">From <input id="date-from" type="date" /></label>
    <label class="date-field">To <input id="date-to" type="date" /></label>
    <button class="date-reset" id="date-reset" type="button">FULL RANGE</button>
  </div>
  <!-- STAT CARDS -->
  <div class="cards" id="cards">
    <div class="card accent-blue">
      <div class="card-label">Final NAV</div>
      <div class="card-value" id="stat-nav">—</div>
      <div class="card-sub" id="stat-start">Start: —</div>
    </div>
    <div class="card" id="card-pnl">
      <div class="card-label">P&amp;L</div>
      <div class="card-value" id="stat-pnl">—</div>
      <div class="card-sub" id="stat-pnl-pct">—</div>
    </div>
    <div class="card accent-amber">
      <div class="card-label">Trading Days</div>
      <div class="card-value" id="stat-days">—</div>
      <div class="card-sub" id="stat-period">Period</div>
    </div>
    <div class="card">
      <div class="card-label">Current State</div>
      <div class="card-value" id="stat-regime">—</div>
      <div class="card-sub">Strategy Signal</div>
    </div>
    <div class="card">
      <div class="card-label" id="label-vs-benchmark">vs Benchmark</div>
      <div class="card-value" id="stat-vs-qqq">—</div>
      <div class="card-sub">Alpha (normalised)</div>
    </div>
    <div class="card accent-blue">
      <div class="card-label">Beta</div>
      <div class="card-value" id="stat-beta">—</div>
      <div class="card-sub">vs Benchmark</div>
    </div>
    <div class="card accent-red">
      <div class="card-label">Max Drawdown</div>
      <div class="card-value neg" id="stat-drawdown">—</div>
      <div class="card-sub">Peak to trough</div>
    </div>
    <div class="card accent-amber">
      <div class="card-label">Sharpe Ratio</div>
      <div class="card-value" id="stat-sharpe">—</div>
      <div class="card-sub">Annualised</div>
    </div>
  </div>

  <!-- STRATEGY STATE TIMELINE -->
  <div class="panel">
    <div class="panel-header">
      <span class="panel-title">Strategy State Timeline</span>
      <div class="legend state-legend" id="state-legend"></div>
    </div>
    <div class="panel-body">
      <div class="regime-bar-wrap" id="regime-bar"></div>
      <div class="regime-labels">
        <span id="regime-start">—</span>
        <span id="regime-end">—</span>
      </div>
    </div>
  </div>

  <!-- NAV CHART -->
  <div class="panel">
    <div class="panel-header">
      <span class="panel-title" id="nav-panel-title">NAV vs Benchmark — Normalised to 100</span>
      <div class="legend">
        <div class="legend-item"><div class="legend-dot" style="background:var(--blue)"></div>Strategy</div>
        <div class="legend-item"><div class="legend-dot" style="background:var(--muted); border-top: 1px dashed var(--muted); height:0"></div><span id="legend-benchmark-label">Benchmark</span></div>
      </div>
    </div>
    <div class="panel-body">
      <div class="chart-wrap"><canvas id="nav-chart"></canvas></div>
    </div>
  </div>
  <div class="panel">
    <div class="panel-header">
      <span class="panel-title">Drawdown</span>
      <div class="legend"><div class="legend-item"><div class="legend-dot" style="background:var(--red)"></div>Underwater from peak</div></div>
    </div>
    <div class="panel-body">
      <div class="drawdown-wrap"><canvas id="drawdown-chart"></canvas></div>
    </div>
  </div>
  </section>
</main>

<footer>
  <span>AUTO-UPDATED DAILY VIA <a href="https://github.com/DanielHCheung/SimpleStockWorker">GITHUB</a> ACTIONS</span>
  <span id="data-ts">DATA AS OF —</span>
</footer>

<script>
  // Live clock
  function tick() {
    const now = new Date();
    document.getElementById('live-time').textContent =
      now.toUTCString().split(' ')[4];
  }
  tick();
  setInterval(tick, 1000);

  // ── STRATEGY STATE ──
  let manifest = null;
  let currentChart = null;
  let drawdownChart = null;
  let currentId = null;
  const strategyCache = {}; // id -> data, avoids refetching on tab switch
  let currentData = null;

  // Allow deep-linking / bookmarking a strategy: ?strategy=<id>
  function getRequestedId() {
    return new URLSearchParams(window.location.search).get('strategy');
  }

  function setRequestedId(id) {
    const url = new URL(window.location.href);
    url.searchParams.set('strategy', id);
    window.history.replaceState({}, '', url);
  }

  // Load manifest, then the initially-selected strategy
  fetch('./data/manifest.json')
    .then(r => r.json())
    .then(m => {
      manifest = m;
      if (!manifest.strategies || manifest.strategies.length === 0) {
        throw new Error('No strategies in manifest');
      }
      renderStrategyBar();
      document.getElementById('collapse-sidebar').addEventListener('click', () => {
        const sidebar = document.getElementById('sidebar');
        sidebar.classList.toggle('collapsed');
        document.getElementById('collapse-sidebar').textContent =
          sidebar.classList.contains('collapsed') ? '›' : '‹';
      });
      document.getElementById('date-from').addEventListener('change', () => render(currentData));
      document.getElementById('date-to').addEventListener('change', () => render(currentData));
      document.getElementById('date-reset').addEventListener('click', () => {
        document.getElementById('date-from').value = '';
        document.getElementById('date-to').value = '';
        render(currentData);
      });
      const requested = getRequestedId();
      const initial = manifest.strategies.find(s => s.id === requested) || manifest.strategies[0];
      loadStrategy(initial.id);
    })
    .catch(() => {
      document.getElementById('loading').textContent = 'DATA UNAVAILABLE';
    });

  function renderStrategyBar() {
    const bar = document.getElementById('strategy-bar');
    bar.innerHTML = '';
    manifest.strategies.forEach(s => {
      const btn = document.createElement('button');
      btn.className = 'strategy-tab';
      btn.dataset.id = s.id;
      const nav = s.final_nav != null ? '$' + fmt(s.final_nav) : '—';
      btn.innerHTML = `<span class="tab-text">${s.name}</span><span class="tab-nav">${nav}</span>`;
      btn.addEventListener('click', () => loadStrategy(s.id));
      bar.appendChild(btn);
    });
  }

  function setActiveTab(id) {
    document.querySelectorAll('.strategy-tab').forEach(el => {
      el.classList.toggle('active', el.dataset.id === id);
    });
  }

  function loadStrategy(id) {
    if (id === currentId) return;
    setActiveTab(id);
    setRequestedId(id);
    currentId = id;
    document.getElementById('date-from').value = '';
    document.getElementById('date-to').value = '';

    if (strategyCache[id]) {
      render(strategyCache[id]);
      return;
    }

    document.getElementById('loading').style.display = 'flex';
    document.getElementById('loading').textContent = '';
    const span = document.createElement('span');
    span.textContent = 'LOADING DATA';
    const blink = document.createElement('span');
    blink.className = 'blink';
    blink.textContent = '_';
    document.getElementById('loading').append(span, blink);

    fetch(`./data/strategies/${id}.json`)
      .then(r => r.json())
      .then(data => {
        strategyCache[id] = data;
        document.getElementById('loading').style.display = 'none';
        render(data);
      })
      .catch(() => {
        document.getElementById('loading').textContent = 'DATA UNAVAILABLE';
      });
  }

  function fmt(n) {
    return n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function getWarmupDays(data) {
    if (Number.isFinite(data.warmup_days)) return Math.max(0, data.warmup_days);
    const params = data.params || {};
    return Math.max(
      params.trend_period || 0,
      (params.train_window || 0) + (params.forecast_horizon || 0) + 5
    );
  }

  function render(data) {
    if (!data) return;
    currentData = data;
    const rawRegimes = data.regimes || [];
    // Do not plot the leading model warm-up period. It contains no actionable
    // signal and makes ML strategies look artificially flat.
    const warmupDays = getWarmupDays(data);
    let firstSignal = rawRegimes.findIndex((state, index) =>
      state !== null && state !== undefined &&
      (index === 0 || state !== rawRegimes[0])
    );
    if (firstSignal < 0) firstSignal = 0;
    firstSignal = Math.min(warmupDays, data.dates.length - 1, Math.max(firstSignal, warmupDays));
    const fromInput = document.getElementById('date-from').value;
    const toInput = document.getElementById('date-to').value;
    const inputStart = fromInput || data.dates[firstSignal];
    const startDate = inputStart > data.dates[firstSignal]
      ? inputStart
      : data.dates[firstSignal];
    const endDate = toInput || data.dates[data.dates.length - 1];
    document.getElementById('date-from').min = data.dates[firstSignal];
    document.getElementById('date-from').max = data.dates[data.dates.length - 1];
    document.getElementById('date-to').min = data.dates[firstSignal];
    document.getElementById('date-to').max = data.dates[data.dates.length - 1];
    const indexes = data.dates.map((date, index) => ({ date, index }))
      .filter(item => item.date >= startDate && item.date <= endDate)
      .map(item => item.index);
    if (!indexes.length) return;
    const dates = indexes.map(i => data.dates[i]);
    const nav = indexes.map(i => data.nav[i]);
    const regimes = indexes.map(i => rawRegimes[i]);
    // Generic reference series: falls back to "benchmark"/"BENCHMARK" if a
    // strategy's JSON predates this field, but normally comes straight from
    // config.benchmark_ticker via main.py.
    const benchmark = data.benchmark || [];
    const benchmarkTicker = data.benchmark_ticker || 'Benchmark';

    // ── STATS ──
    const startNav = nav[0], endNav = nav[nav.length - 1];
    const pnl = endNav - startNav;
    const pnlPct = (pnl / startNav) * 100;

    const benchmarkSlice = indexes.map(i => benchmark[i]);
    const hasBenchmark = benchmarkSlice.length === nav.length &&
      benchmarkSlice.every(value => Number.isFinite(value) && value > 0);
    const startBenchmark = benchmarkSlice[0], endBenchmark = benchmarkSlice[benchmarkSlice.length - 1];
    const benchmarkReturn = hasBenchmark ? ((endBenchmark - startBenchmark) / startBenchmark) * 100 : null;
    const alpha = benchmarkReturn === null ? null : pnlPct - benchmarkReturn;

    const currentRegime = [...regimes].reverse().find(r => r !== null && r !== undefined) || '—';
    const strategyReturns = nav.slice(1).map((v, i) => v / nav[i] - 1);
    const benchmarkReturns = hasBenchmark
      ? benchmarkSlice.slice(1).map((v, i) => v / benchmarkSlice[i] - 1)
      : [];
    const mean = values => values.length ? values.reduce((sum, value) => sum + value, 0) / values.length : 0;
    const benchmarkMean = mean(benchmarkReturns);
    const covariance = hasBenchmark ? mean(strategyReturns.map((value, i) =>
      (value - mean(strategyReturns)) * (benchmarkReturns[i] - benchmarkMean)
    )) : 0;
    const benchmarkVariance = mean(benchmarkReturns.map(value => (value - benchmarkMean) ** 2));
    const beta = benchmarkVariance ? covariance / benchmarkVariance : null;
    let peak = nav[0];
    const drawdowns = nav.map(value => {
      peak = Math.max(peak, value);
      return (value / peak - 1) * 100;
    });
    const maxDrawdown = Math.min(...drawdowns);
    const volatility = strategyReturns.length > 1
      ? Math.sqrt(mean(strategyReturns.map(value => (value - mean(strategyReturns)) ** 2)))
      : 0;
    const sharpe = volatility ? (mean(strategyReturns) / volatility) * Math.sqrt(252) : 0;

    document.getElementById('stat-nav').textContent = '$' + fmt(endNav);
    document.getElementById('stat-start').textContent = 'Start: $' + fmt(startNav);

    const pnlEl = document.getElementById('stat-pnl');
    const pnlCard = document.getElementById('card-pnl');
    pnlEl.textContent = (pnl >= 0 ? '+$' : '-$') + fmt(Math.abs(pnl));
    pnlEl.className = 'card-value ' + (pnl >= 0 ? 'pos' : 'neg');
    pnlCard.classList.remove('accent-green', 'accent-red');
    pnlCard.classList.add(pnl >= 0 ? 'accent-green' : 'accent-red');
    document.getElementById('stat-pnl-pct').textContent =
      (pnlPct >= 0 ? '+' : '') + pnlPct.toFixed(2) + '%';

    document.getElementById('stat-days').textContent = dates.length;
    document.getElementById('stat-period').textContent =
      dates[0] + ' → ' + dates[dates.length - 1];

    document.getElementById('stat-regime').textContent = currentRegime;

    document.getElementById('label-vs-benchmark').textContent = `vs ${benchmarkTicker}`;
    document.getElementById('nav-panel-title').textContent = `NAV vs ${benchmarkTicker} — Normalised to 100`;
    document.getElementById('legend-benchmark-label').textContent = benchmarkTicker;

    const alphaEl = document.getElementById('stat-vs-qqq');
    alphaEl.textContent = alpha === null ? '—' : (alpha >= 0 ? '+' : '') + alpha.toFixed(2) + '%';
    alphaEl.className = alpha === null ? 'card-value' : 'card-value ' + (alpha >= 0 ? 'pos' : 'neg');
    document.getElementById('stat-beta').textContent = beta === null ? '—' : beta.toFixed(2);
    document.getElementById('stat-drawdown').textContent = maxDrawdown.toFixed(2) + '%';
    document.getElementById('stat-sharpe').textContent = sharpe.toFixed(2);

    // ── STRATEGY STATE BAR ──
    const states = [...new Set(regimes.filter(state => state !== null && state !== undefined))];
    const stateColors = ['var(--green)', 'var(--red)', 'var(--blue)', 'var(--accent)', '#a78bfa', '#f97316'];
    const stateColor = state => stateColors[Math.max(0, states.indexOf(state)) % stateColors.length];
    const legend = document.getElementById('state-legend');
    legend.innerHTML = states.map(state =>
      `<div class="legend-item"><div class="legend-dot" style="background:${stateColor(state)}"></div>${state}</div>`
    ).join('');
    if (regimes.some(state => state === null || state === undefined)) {
      legend.innerHTML += '<div class="legend-item"><div class="legend-dot" style="background:var(--border2)"></div>No signal</div>';
    }
    const bar = document.getElementById('regime-bar');
    bar.innerHTML = '';
    regimes.forEach(r => {
      const seg = document.createElement('div');
      seg.className = 'regime-segment';
      seg.style.background = r === null || r === undefined ? 'var(--border2)' : stateColor(r);
      seg.title = r || 'No signal';
      bar.appendChild(seg);
    });
    document.getElementById('regime-start').textContent = dates[0];
    document.getElementById('regime-end').textContent = dates[dates.length - 1];

    // ── DATA TIMESTAMP ──
    document.getElementById('data-ts').textContent =
      'DATA AS OF ' + dates[dates.length - 1].toUpperCase();

    // ── CHART ──
    const norm = arr => arr.map(v => v / arr[0] * 100);
    const navN = norm(nav);
    const benchmarkN = hasBenchmark ? norm(benchmarkSlice) : [];

    // Build strategy-state background zones without assuming A/B labels.
    const stateFills = [
      'rgba(0,214,143,0.06)', 'rgba(255,77,109,0.06)',
      'rgba(77,166,255,0.06)', 'rgba(245,166,35,0.06)',
      'rgba(167,139,250,0.06)', 'rgba(249,115,22,0.06)'
    ];
    const regimePlugin = {
      id: 'regimeBg',
      beforeDraw(chart) {
        const { ctx, chartArea, scales } = chart;
        if (!chartArea) return;
        const xScale = scales.x;
        regimes.forEach((r, i) => {
          if (!r) return;
          const x0 = xScale.getPixelForValue(i - 0.5);
          const x1 = xScale.getPixelForValue(i + 0.5);
          ctx.save();
          ctx.fillStyle = stateFills[Math.max(0, states.indexOf(r)) % stateFills.length];
          ctx.fillRect(
            Math.max(x0, chartArea.left), chartArea.top,
            Math.min(x1, chartArea.right) - Math.max(x0, chartArea.left),
            chartArea.height
          );
          ctx.restore();
        });
      }
    };

    if (currentChart) currentChart.destroy();
    if (drawdownChart) drawdownChart.destroy();

    currentChart = new Chart(document.getElementById('nav-chart'), {
      type: 'line',
      plugins: [regimePlugin],
      data: {
        labels: dates,
        datasets: [
          {
            label: 'Strategy NAV',
            data: navN,
            borderColor: '#4da6ff',
            borderWidth: 2,
            pointRadius: 0,
            pointHoverRadius: 4,
            pointHoverBackgroundColor: '#4da6ff',
            tension: 0.2,
            fill: {
              target: 'origin',
              above: 'rgba(77,166,255,0.05)',
            }
          },
          ...(hasBenchmark ? [{
            label: benchmarkTicker,
            data: benchmarkN,
            borderColor: '#556070',
            borderWidth: 1.5,
            borderDash: [4, 4],
            pointRadius: 0,
            pointHoverRadius: 3,
            tension: 0.2,
          }] : [])
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#0e1318',
            borderColor: '#1e2730',
            borderWidth: 1,
            titleColor: '#556070',
            bodyColor: '#c8d6e5',
            titleFont: { family: 'IBM Plex Mono', size: 10 },
            bodyFont: { family: 'IBM Plex Mono', size: 11 },
            padding: 10,
            callbacks: {
              title: items => items[0].label,
              label: ctx => {
                const regime = regimes[ctx.dataIndex];
                const suffix = regime ? ` [${regime}]` : '';
                return ` ${ctx.dataset.label}: ${ctx.parsed.y.toFixed(3)}${ctx.datasetIndex === 0 ? suffix : ''}`;
              }
            }
          }
        },
        scales: {
          x: {
            ticks: {
              color: '#556070',
              font: { family: 'IBM Plex Mono', size: 9 },
              maxTicksLimit: 10,
              maxRotation: 0,
            },
            grid: { color: '#1e2730' }
          },
          y: {
            ticks: {
              color: '#556070',
              font: { family: 'IBM Plex Mono', size: 9 },
              callback: v => v.toFixed(1)
            },
            grid: { color: '#1e2730' }
          }
        }
      }
    });

    drawdownChart = new Chart(document.getElementById('drawdown-chart'), {
      type: 'line',
      data: {
        labels: dates,
        datasets: [{
          label: 'Drawdown',
          data: drawdowns,
          borderColor: '#ff4d6d',
          backgroundColor: 'rgba(255,77,109,0.12)',
          borderWidth: 1.5,
          pointRadius: 0,
          fill: true,
          tension: 0.15,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: { legend: { display: false } },
        scales: {
          x: { ticks: { color: '#556070', maxTicksLimit: 10, maxRotation: 0 }, grid: { color: '#1e2730' } },
          y: { ticks: { color: '#556070', callback: value => value.toFixed(1) + '%' }, grid: { color: '#1e2730' } }
        }
      }
    });
  }
</script>

</body>
</html>